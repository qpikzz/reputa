DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reputa
JWT_SECRET=change-me-in-production
# COOKIE_SECURE=true  # включить только за HTTPS (default: false)

# Gemini API (TG-002 OCR): ключ из Google AI Studio, например "AIza..." или "AQ...."
GEMINI_API_KEY=

# GigaChat API (TG-002, анализ текста): Authorization Key из кабинета
# developers.sber.ru (base64 client_id:client_secret), например "MDFh...". Модель:
# GigaChat-2 / GigaChat-Pro / GigaChat-Max.
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_SCOPE=GIGACHAT_API_PERS
